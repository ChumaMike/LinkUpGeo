# Copy this file to .env and fill in your values
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=

# Flask environment: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=False
PORT=5000

# Database (leave blank to use SQLite in development)
DATABASE_URL=

# Google Gemini AI
GEMINI_API_KEY=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenWeatherMap
OPENWEATHER_API_KEY=

# Admin master key (set a strong random string)
ADMIN_SECRET=

# Redis (optional — falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379/0

# File uploads
UPLOAD_FOLDER=src/static/uploads
